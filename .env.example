# ==============================================================================
# Miami-Dade Building Permits Pipeline - Configuration & Secrets Reference
# In production (GitHub Actions / Cloud), populate these via GitHub Secrets / Env
# ==============================================================================

# Required / Configurable via GitHub Secret:
# MIAMI_DADE_PERMITS_URL: The official Miami-Dade County ArcGIS REST MapServer query endpoint
MIAMI_DADE_PERMITS_URL=https://gisweb.miamidade.gov/arcgis/rest/services/MD_LandInformation/MapServer/1/query

# Optional Secret: ArcGIS API Token or Bearer Token (if your GIS endpoint requires auth)
ARCGIS_API_TOKEN=

# Optional Secret: Target Database Connection (defaults to local SQLite if unset)
# Examples:
#   sqlite:///data/permits.db
#   postgresql://postgres:password@db.example.com:5432/permits
DATABASE_URL=sqlite:///data/permits.db

# Ingestion Parameters
PERMIT_PAGE_SIZE=1000
PERMIT_REQUEST_TIMEOUT=30
PERMIT_MAX_RETRIES=5
PERMIT_RETRY_BACKOFF_FACTOR=1.5
PERMIT_REQUEST_DELAY_SECONDS=0.2
PERMIT_BACKFILL_DAYS=90
PERMIT_INCREMENTAL_OVERLAP_MINUTES=120

# Logging Configuration
LOG_DIR=logs
LOG_LEVEL=INFO
USER_AGENT=MiamiDadePermitIngestionPipeline/1.0 (+https://github.com/partnerspk77-max/new_user)
